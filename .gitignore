# A .gitignore for Keil projects.
# Taken mostly from http://www.keil.com/support/man/docs/uv4/uv4_b_filetypes.htm

# User-specific uVision files
*.opt
*.uvopt
*.uvoptx
*.uvgui
*.uvgui.*
*.uvguix.*

# Listing files
*.cod
*.htm
*.i
*.lst
*.map
*.m51
*.m66
# define exception below if needed
*.scr

# Object and HEX files
*.axf
*.b[0-3][0-9]
*.hex
*.d
*.crf
*.elf
*.hex
*.h86
*.lib
*.obj
*.o
*.sbr
*.exe

# Build files
# define exception below if needed
*.bat
*._ia
*.__i
*._ii

# Generated output files
Keil/Listings/*
Keil/Objects/*
Keil/_build*/
_build/
build/
__pycache__/
artifacts/japanese-calendar/*.log
artifacts/japanese-calendar/*.ppm
artifacts/japanese-calendar/rollback-test.c
artifacts/japanese-rokuyo/*.log
artifacts/japanese-rokuyo/*.ppm
artifacts/japanese-rokuyo/*.bin
artifacts/japanese-rokuyo/*.elf
artifacts/japanese-rokuyo/*.exe
artifacts/japanese-rokuyo/host-src/
artifacts/japanese-rokuyo/rollback-test.c

# Debugger files
# define exception below if needed
*.ini

# Other files
*.build_log.htm
*.cdb
*.dep
*.ic
*.lin
*.lnp
*.orc
# define exception below if needed
*.pack
# define exception below if needed
*.pdsc
*.plg
# define exception below if needed
*.sct
*.sfd
*.sfr

# Miscellaneous
*.tra
*.bin
*.fed
*.l1p
*.l2p
*.iex

# Vscode config files
.vscode/

# To explicitly override the above, define any exceptions here; e.g.:
# !my_customized_scatter_file.sct

!SDK/*/components/softdevice/*/hex/*.hex
!tools/bootloader/*.hex
!tools/bin/*.exe
!tools/*.bat
RTE_Components.h
EventRecorderStub.scvd
JLinkLog.txt
